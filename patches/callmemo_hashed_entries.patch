+    Js.Unsafe.js_expr(
+      {js|(function (hash, v) {
+  try { const h = hash(v); return h === null ? null : h[0] + ":" + h[1]; }
+  catch (_) { return null; }
+})|js},
+    )
+  );
+let key_string = (a: 'a): option(string) => {
+  let r: Js.opt(Js.t(Js.js_string)) =
+    Js.Unsafe.fun_call(
+      Lazy.force(key_impl),
+      [|js_hash(), Js.Unsafe.inject(a)|],
+    );
+  Js.Opt.case(r, () => None, s => Some(Js.to_string(s)));
+};
