diff --git a/src/util/DebugSizes.re b/src/util/DebugSizes.re
new file mode 100644
index 0000000000..c2e8197e5c
--- /dev/null
+++ b/src/util/DebugSizes.re
@@ -0,0 +1,8 @@
+/* PROBE (^ticket(45), local only): the sizes of long-lived tables, by name, read
+   from the page as window.__hazel45() after each edit, to find the one
+   that grows. Each table registers a function returning its size. */
+let table: ref(list((string, unit => int))) = ref([]);
+let register = (name: string, size: unit => int): unit =>
+  table := [(name, size), ...table^];
+let all = (): list((string, int)) =>
+  List.rev_map(((name, size)) => (name, size()), table^);
